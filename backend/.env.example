# External services (Railway). Copy to `.env` and fill in real values.
# MongoDB — primary NoSQL datastore.
MONGO_URL=mongodb://user:password@host:port
MONGO_DB_NAME=santana_biserica

# Redis — shared in-memory cache.
REDIS_URL=redis://default:password@host:port

# App
ENVIRONMENT=development
DEBUG=true

# Auth — secret used to sign admin JWTs (generate with: python -c
# "import secrets; print(secrets.token_hex(32))"). Keep private.
JWT_SECRET=change-me
# JWT_ALGORITHM=HS256
# JWT_EXPIRY_DAYS=7

# Cookie behaviour. On localhost the defaults (lax + insecure) work. For a
# cross-site production deployment set COOKIE_SECURE=true and COOKIE_SAMESITE=none.
# COOKIE_SECURE=false
# COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=

# CORS — comma-separated frontend origins allowed to send credentials.
CORS_ORIGINS=http://localhost:5173
